# Only YOUR private things go here. Everything else has working defaults
# (SQLite database, auto-generated secret key, eager tasks — no Redis needed).

# Discord alerts (optional — leave empty to disable)
DISCORD_ENABLED=False
DISCORD_WEBHOOK_URL=
DISCORD_MIN_SEVERITY=LOW

# --- Advanced (leave alone unless deploying to production) ---
# DJANGO_SECRET_KEY=   # auto-generated if empty
# DJANGO_DEBUG=True
# ALLOWED_HOSTS=*
# DATABASE_URL=sqlite:///db.sqlite3
# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=True
# CSRF_TRUSTED_ORIGINS=
